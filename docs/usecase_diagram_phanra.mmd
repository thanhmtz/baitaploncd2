  usecase "Theo dõi nước" as UC6a
  usecase "Thêm lượng nước" as UC6b
  
  usecase "Theo dõi cân nặng" as UC7a
  usecase "Thêm cân nặng mới" as UC7b
  usecase "Xem lịch sử cân nặng" as UC7c
  
  usecase "Theo dõi giấc ngủ" as UC8a
  usecase "Ghi nhận giấc ngủ" as UC8b
  
  usecase "Đo nhịp tim" as UC9a
  usecase "Xem lịch sử nhịp tim" as UC9b
  
  usecase "Xem thống kê\n(ngày, tuần, tháng)" as UC10a
}

package "CÔNG THỨC NẤU ĂN (Recipes)" {
  usecase "Xem danh sách recipe" as UC11a
  usecase "Tìm kiếm recipe" as UC11b
  usecase "Lọc theo mục tiêu\n(giảm cân, tăng cơ...)" as UC11c

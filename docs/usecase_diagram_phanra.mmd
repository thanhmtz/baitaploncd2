  usecase "Xem nguyên liệu" as UC12b
  usecase "Xem cách nấu" as UC12c
  usecase "Thêm recipe vào bữa ăn" as UC12d
  usecase "Lưu recipe yêu thích" as UC12e
  usecase "Chia sẻ recipe" as UC12f
}

package "KẾ HOẠCH TẬP (Plans)" {
  usecase "Xem danh sách kế hoạch" as UC14a

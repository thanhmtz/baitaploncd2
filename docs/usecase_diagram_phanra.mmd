@startuml HealthTracker_UseCase_PhanRa

left to right direction

skinparam handwritten false
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecaseBorderStyle rounded
skinparam usecaseBorderThickness 1.5
skinparam usecaseFontSize 10

actor "Người dùng" as User

package "QUẢN LÝ TÀI KHOẢN" {
  usecase "Đăng nhập Email" as UC1a
  usecase "Đăng nhập Google" as UC1b
  usecase "Đăng nhập Facebook" as UC1c
  usecase "Đăng ký tài khoản" as UC1d
  usecase "Quên mật khẩu" as UC1e
  usecase "Đăng xuất" as UC1f
  
  usecase "Xem profile" as UC2a
  usecase "Chỉnh sửa profile" as UC2b
  usecase "Cập nhật thông tin\n(chiều cao, cân nặng, tuổi, giới tính)" as UC2c
  
  usecase "Cài đặt ứng dụng" as UC3a
  usecase "Chế độ tối/sáng" as UC3b
  usecase "Quản lý thông báo" as UC3c
}

package "NHẬT KÝ SỨC KHỎE (Diary)" {
  usecase "Xem tổng quan diary" as UC5a
  usecase "Theo dõi calories" as UC5b
  usecase "Thêm bữa ăn\n(Breakfast, Lunch, Dinner, Snack)" as UC5c
